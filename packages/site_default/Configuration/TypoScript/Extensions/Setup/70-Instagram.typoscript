plugin.tx_nsinstagram_instagramfeeds {
    view {
        templateRootPaths {
            0 = EXT:ns_instagram/Resources/Private/Templates/
            1 = {$plugin.tx_nsinstagram_instagramfeeds.view.templateRootPath}
            10 = EXT:site_default/Resources/Private/Instagram/Templates/
        }

        partialRootPaths {
            0 = EXT:ns_instagram/Resources/Private/Partials/
            1 = {$plugin.tx_nsinstagram_instagramfeeds.view.partialRootPath}
            10 = EXT:site_default/Resources/Private/Instagram/Partials/
            20 = EXT:site_default/Resources/Private/Content/Partials/
            1712245685 = {$plugin.tx_mediautils.view.partialRootPath}
        }

        layoutRootPaths {
            0 = EXT:ns_instagram/Resources/Private/Layouts/
            1 = {$plugin.tx_nsinstagram_instagramfeeds.view.layoutRootPath}
            10 = EXT:site_default/Resources/Private/Instagram/Layouts/
        }
    }
}

page = PAGE
page {

    includeCSS {
		nsinstagramFontAwesomeCss >
        nsinstagramFancyboxCss >
		nsinstagramCustomcss >
	}

    includeJS {
        nsinstagramjQuery >
    }

    includeJSFooter {
        nsinstagramFancyboxJs >
    }
}
