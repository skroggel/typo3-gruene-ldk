#############################################################################
# Remove content-elements that are not used / only used as sub-elements
#############################################################################
#
# From v13 on the wizward automatically registers the groups and elements from the TCA configuration.
# To remove items we have to use "mod.wizards.newContentElement.wizardItems.<group>.removeItems := addToList(html)"
# @see https://docs.typo3.org/c/typo3/cms-core/main/en-us/Changelog/13.0/Breaking-102834-RemoveItemsFromNewContentElementWizard.html
#
mod.wizards.newContentElement.wizardItems {

	// removing elements that are only used in a container
	default.removeItems := addToList(madj2k_linklistitem, madj2k_linklist, madj2k_accordionitem, madj2k_parallaxstackitem, madj2k_parallaxstackitemquote)

    forms.removeItems = form_formframework, felogin_login

    greens_contact.removeItems = greenscontact_list, greenscontact_slider, greenscontact_detail,

    ke_search.removeItems = ke_search_pi1, ke_search_pi2, ke_search_pi3

    Klarokratie.removeItems = klarokratie_trackingcode

	news.removeItems = news_pi1, news_newsliststicky, news_newsdetail, news_categorylist

    plugins.removeItems = greenscontact_list, greenscontact_slider, greenscontact_detail, nsinstagram_instagramfeeds

    special.removeItems = div
}
